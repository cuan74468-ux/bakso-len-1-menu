// Read-only public projection. Private spreadsheet; DB_ID in Script Properties.
const MENU_HEADERS=['id_menu','kategori','nama_menu','deskripsi','harga_porsi','harga_satuan','badge','status','foto_url','urutan'];
const COURIER_HEADERS=['id_kurir','nama_kurir','whatsapp','area_layanan','aktif','urutan'];
const SETTINGS_HEADERS=['key','value','keterangan'];
function rows_(ss,name,headers){const sh=ss.getSheetByName(name);if(!sh)throw Error('Missing table');const values=sh.getDataRange().getDisplayValues();const head=values.shift();if(!headers.every((h,i)=>head[i]===h))throw Error('Schema mismatch');return values.filter(r=>r.some(v=>v!=='' )).map(r=>Object.fromEntries(headers.map((h,i)=>[h,String(r[i]||'').trim()])));}
function integer_(s){if(s==='')return null;if(!/^\d+$/.test(s)||!Number.isSafeInteger(Number(s))||Number(s)<=0)throw Error('Invalid price');return Number(s);}
function normalizePhone_(s){if(!/^\+?[\d\s()-]+$/.test(String(s).trim()))return '';let n=String(s).replace(/\D/g,'');if(n.startsWith('0'))n='62'+n.slice(1);return /^628\d{7,11}$/.test(n)?n:'';}
function unique_(list,key){const ids=new Set();for(const r of list){if(!r[key]||ids.has(r[key]))throw Error('Invalid identifier');ids.add(r[key]);}}
function minute_(s){if(!/^([01]\d|2[0-3]):[0-5]\d$/.test(s))throw Error('Invalid time');return Number(s.slice(0,2))*60+Number(s.slice(3));}
function json_(data){return ContentService.createTextOutput(JSON.stringify(data)).setMimeType(ContentService.MimeType.JSON);}
function doGet(){try{const id=PropertiesService.getScriptProperties().getProperty('DB_ID');if(!id)throw Error('Missing configuration');const ss=SpreadsheetApp.openById(id);const settings=rows_(ss,'Pengaturan',SETTINGS_HEADERS);unique_(settings,'key');const cfg=Object.fromEntries(settings.map(r=>[r.key,r.value]));if(cfg.timezone!=='Asia/Jakarta'||!['BUKA','TUTUP'].includes(cfg.status_toko))throw Error('Invalid store configuration');const now=new Date(),t=minute_(Utilities.formatDate(now,'Asia/Jakarta','HH:mm')),start=minute_(cfg.jam_buka),end=minute_(cfg.jam_tutup);if(start>=end)throw Error('Invalid opening hours');const menus=rows_(ss,'Menu',MENU_HEADERS);unique_(menus,'id_menu');const menu=menus.map(r=>{const p=integer_(r.harga_porsi),s=integer_(r.harga_satuan);if(!r.nama_menu||(!p&&!s)||!['Bakso','Mie & Bakar','Topping','Minuman'].includes(r.kategori)||!['READY','HABIS'].includes(r.status))throw Error('Invalid menu row');return {id_menu:r.id_menu,kategori:r.kategori,nama_menu:r.nama_menu,deskripsi:r.deskripsi,harga_porsi:p,harga_satuan:s,badge:['Best','New'].includes(r.badge)?r.badge:'',status:r.status,foto_url:/^https:\/\//.test(r.foto_url)?r.foto_url:'',urutan:Number(r.urutan)||999};}).sort((a,b)=>a.urutan-b.urutan);const couriers=rows_(ss,'Kurir',COURIER_HEADERS);unique_(couriers,'id_kurir');const kurir=couriers.filter(r=>r.aktif==='YA').map(r=>{const wa=normalizePhone_(r.whatsapp);if(!wa||!r.nama_kurir)throw Error('Invalid courier');return {id_kurir:r.id_kurir,nama_kurir:r.nama_kurir,whatsapp:wa,area_layanan:r.area_layanan,urutan:Number(r.urutan)||999};}).sort((a,b)=>a.urutan-b.urutan);return json_({ok:true,schema:1,generated_at:now.toISOString(),store:{open:cfg.status_toko==='BUKA'&&t>=start&&t<end,jam_buka:cfg.jam_buka,jam_tutup:cfg.jam_tutup,timezone:'Asia/Jakarta'},menu,kurir});}catch(e){return json_({ok:false,error:'CATALOG_UNAVAILABLE'});}}
